{
  "expo": {
    "name": "ARGOLET",
    "slug": "argolet",
    "scheme": "argolet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F8",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#FFFFFF" },
    "ios": {
      "bundleIdentifier": "vn.argolet.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ARGOLET dùng camera để chụp chứng từ.",
        "NSPhotoLibraryUsageDescription": "ARGOLET cần truy cập ảnh để tải chứng từ."
      }
    },
    "android": {
      "package": "vn.argolet.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#FFFFFF" },
      "permissions": ["CAMERA"]
    },
    "web": { "bundler": "metro", "favicon": "./assets/icon.png" },
    "plugins": ["expo-secure-store"],
    "extra": { "apiUrl": null }
  }
}
